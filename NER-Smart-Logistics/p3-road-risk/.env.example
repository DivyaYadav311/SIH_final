# Optional environment settings for historical road-impact data pipeline
# No API keys are required for public GDELT and ASDMA access.
# Add project-local credentials here only if you later add a private source.

GDELT_API_URL=https://api.gdeltproject.org/api/v2/doc/doc
OSM_DATA_PATH=data/raw/osm/india-latest.osm.pbf
DEFAULT_TIMEZONE=Asia/Kolkata

# Copernicus Data Space Ecosystem client credentials. Never commit real values.
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
