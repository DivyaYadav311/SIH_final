# ==============================================================================
# PRAVAH — NER Smart Logistics Unified Environment Configuration
# ==============================================================================

# Copernicus Data Space Ecosystem (P3 Road Risk & Satellite Intelligence)
CDSE_CLIENT_ID=your_cdse_client_id_here
CDSE_CLIENT_SECRET=your_cdse_client_secret_here

# Google Gemini AI Intelligence (Disaster Advisory & Route Explanation)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.7-flash
GEMINI_TIMEOUT_SECONDS=15
GEMINI_TEMPERATURE=0.2

# Hugging Face CLIP Verification (P6 Control Tower Image Incident Analysis)
HF_TOKEN=your_hf_token_here
HF_CLIP_MODEL=openai/clip-vit-base-patch32

# Indian Railways & Geospatial Routing (P4 Path Optimization)
# Optional third-party machine-readable Indian Railways schedule API (free test tiers may apply).
# Do NOT use railway track geometry as a train service.
INDIAN_RAIL_API_KEY=your_key
INDIAN_RAIL_API_BASE=https://indianrailapi.com/api/v2
# Optional passenger timetable feed.
INDIAN_RAILWAYS_GTFS_PATH=data/indian_railways_gtfs.zip
INDIAN_RAILWAYS_GTFS_URL=https://your-approved-gtfs-feed.zip
# Optional NRSC/Bhuvan exported GeoJSON for server-side point/polygon scoring.
NRSC_LANDSLIDE_GEOJSON=data/nrsc/landslide_hazard.geojson
NRSC_BHUVAN_WMS_URL=https://bhuvan-vec2.nrsc.gov.in/bhuvan/wms
ROUTE_CORRIDOR_BUFFER_KM=80
RISK_GRID_STEP_DEG=0.5

# Inter-Service Communication (Unified Backend defaults)
P3_BASE_URL=http://127.0.0.1:8002
P4_BASE_URL=http://127.0.0.1:8002
P5_BASE_URL=http://127.0.0.1:8002

# Platform Authentication (API key for securing endpoints)
# Generate a strong random key: python -c "import secrets; print(secrets.token_urlsafe(32))"
PRAVAH_API_KEY=
# Comma-separated allowed origins for CORS (leave empty for localhost-only in dev)
PRAVAH_ALLOWED_ORIGINS=http://127.0.0.1:8002,http://localhost:8002,http://127.0.0.1:3000
