# Optional passenger timetable feed.
# Optional third-party machine-readable Indian Railways schedule API (free test tiers may apply).
# INDIAN_RAIL_API_KEY=your_key
# INDIAN_RAIL_API_BASE=https://indianrailapi.com/api/v2 Do NOT use railway track geometry as a train service.
# INDIAN_RAILWAYS_GTFS_PATH=data/indian_railways_gtfs.zip
# INDIAN_RAILWAYS_GTFS_URL=https://your-approved-gtfs-feed.zip
