# NRSC_LANDSLIDE_GEOJSON=data/nrsc/landslide_hazard.geojson
# NRSC_BHUVAN_WMS_URL=https://bhuvan-vec2.nrsc.gov.in/bhuvan/wms
ROUTE_CORRIDOR_BUFFER_KM=80
RISK_GRID_STEP_DEG=0.5
